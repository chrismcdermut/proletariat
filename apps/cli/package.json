{
  "name": "@proletariat/cli-v2",
  "description": "Proletariat CLI v2 - Multi-agent development orchestration",
  "version": "2.0.0-alpha.1",
  "author": "Chris McDermut",
  "bin": {
    "prlt": "./bin/run.js"
  },
  "bugs": "https://github.com/chrismcdermut/proletariat-cli/issues",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^3",
    "@oclif/plugin-commands": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "better-sqlite3": "^9.2.2",
    "chalk": "^4.1.2",
    "chokidar": "^5.0.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "inquirer": "^8.2.5",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/chai": "^4",
    "@types/ink-spinner": "^3.0.5",
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "@types/react": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/chrismcdermut/proletariat-cli",
  "keywords": [
    "multi-agent",
    "development",
    "ai",
    "claude",
    "cursor",
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "prlt",
    "dirname": "proletariat",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-commands",
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "agent": {
        "description": "Manage agents (workers)"
      },
      "ticket": {
        "description": "Manage PMO tickets"
      },
      "repo": {
        "description": "Manage repositories"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init"
    }
  },
  "repository": "chrismcdermut/proletariat-cli",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "clean": "shx rm -rf dist",
    "dev": "tsc --watch",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:unit": "mocha --forbid-only \"test/unit/**/*.test.ts\"",
    "test:e2e": "mocha --forbid-only \"test/e2e/**/*.test.ts\"",
    "test:e2e:pmo": "mocha --forbid-only \"test/e2e/pmo-*.test.ts\"",
    "test:commands": "mocha --forbid-only \"test/commands/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}