{
  "name": "@proletariat/cli",
  "description": "Agent orchestration platform for AI labor - Spin up workers on demand for multi-agent development",
  "version": "0.3.16",
  "author": "Chris McDermut",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "prlt": "./bin/run.js"
  },
  "bugs": "https://github.com/chrismcdermut/proletariat-cli/issues",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^3",
    "@oclif/plugin-commands": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "@oclif/plugin-warn-if-update-available": "^3",
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "inquirer": "^8.2.5",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4",
    "@types/ink-spinner": "^3.0.5",
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "@types/react": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6.0.129",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x"
  },
  "files": [
    "./bin",
    "./dist",
    "./images",
    "./oclif.manifest.json",
    "README.md"
  ],
  "homepage": "https://github.com/chrismcdermut/proletariat-cli",
  "keywords": [
    "cli",
    "multi-agent",
    "ai-agents",
    "coding-assistant",
    "claude",
    "claude-code",
    "git-worktree",
    "automation",
    "ticket-management",
    "project-management",
    "tmux",
    "docker",
    "oclif"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "prlt",
    "dirname": "proletariat",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-commands",
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-warn-if-update-available"
    ],
    "topicSeparator": " ",
    "hooks": {
      "init": "./dist/hooks/init"
    },
    "warn-if-update-available": {
      "timeoutInDays": 1,
      "message": "\n<%= chalk.yellow('Updated prlt available!') %> <%= chalk.dim(config.version) %> → <%= chalk.green(latest) %>\nRun <%= chalk.cyan('npm install -g @proletariat/cli') %> to get the latest\n"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chrismcdermut/proletariat-cli.git"
  },
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3 2>/dev/null || true",
    "build": "shx rm -rf dist && tsc -b",
    "rebuild": "pnpm install && pnpm build",
    "clean": "shx rm -rf dist",
    "dev": "tsc --watch",
    "lint": "eslint",
    "lint:all": "eslint && tsc --noEmit",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:unit": "mocha --forbid-only \"test/unit/**/*.test.ts\"",
    "test:e2e": "mocha --forbid-only \"test/e2e/**/*.test.ts\"",
    "test:e2e:pmo": "mocha --forbid-only \"test/e2e/pmo-*.test.ts\"",
    "test:commands": "mocha --forbid-only \"test/commands/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "roadmap:generate": "node ./bin/run.js roadmap generate --all"
  },
  "types": "dist/index.d.ts"
}
