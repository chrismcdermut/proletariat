{
  "require": [
    "ts-node/register",
    "test/setup/npm-sandbox.ts",
    "test/setup/native-sqlite-check.ts",
    "test/setup/worker-graceful-exit.ts"
  ],
  "watch-extensions": [
    "ts"
  ],
  "recursive": true,
  "reporter": "spec",
  "retries": 1,
  "timeout": 60000,
  "exit": true,
  "parallel": true,
  "jobs": 2,
  "node-option": [
    "loader=ts-node/esm",
    "experimental-specifier-resolution=node"
  ]
}
