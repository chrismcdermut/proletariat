{
  "name": "@proletariat/cli",
  "version": "0.2.0",
  "description": "Multi-agent development CLI - Orchestrate parallel coding agents via git worktrees with memorable themes for distributed development workflows",
  "main": "dist/bin/prlt.js",
  "bin": {
    "prlt": "./dist/bin/prlt.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "pnpm run build && jest --config test/config/jest.integration.js",
    "test:integration:watch": "jest --config test/config/jest.integration.js --watch",
    "test:integration:coverage": "jest --config test/config/jest.integration.js --coverage",
    "test:all": "pnpm run test && pnpm run test:integration",
    "release": "npm publish --access public",
    "publish:otp": "./scripts/publish.sh"
  },
  "keywords": [
    "multi-agent",
    "coding-agents",
    "parallel-development",
    "claude-code",
    "cursor",
    "codex",
    "ai-development",
    "git",
    "worktree",
    "development",
    "orchestration",
    "distributed",
    "themed",
    "cli",
    "workflow",
    "automation"
  ],
  "author": {
    "name": "Chris McDermut",
    "email": "chrismcdermut@gmail.com",
    "url": "https://github.com/chrismcdermut"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrismcdermut/proletariat-cli.git"
  },
  "bugs": {
    "url": "https://github.com/chrismcdermut/proletariat-cli/issues"
  },
  "homepage": "https://github.com/chrismcdermut/proletariat-cli#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^8.2.5"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.44.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "preferGlobal": true,
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
